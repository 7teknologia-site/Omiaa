# Supabase Configuration (Client & Browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Admin Configuration (Server-side Node Backend Only)
# SUPABASE_URL: URL do projeto Supabase para o servidor (fallback para VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: Chave secreta de serviço com privilégios administrativos. NUNCA expor ao navegador!
SUPABASE_SERVICE_ROLE_KEY=

# Payment Gateway Active Configuration
PAYMENT_GATEWAY=infinitepay

# InfinitePay Gateway Configuration
INFINITEPAY_ENABLED=true
INFINITEPAY_HANDLE=seu_handle_aqui
INFINITEPAY_WEBHOOK_URL=https://omiaa-loja.ai.studio/api/webhooks/infinitepay

# Mercado Pago Integration Configuration (Preserved / Configurable)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxx
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxx
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret
